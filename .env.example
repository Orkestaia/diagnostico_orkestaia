# Diagnóstico Orkesta — variables de entorno.
# Copiar a .env.local para desarrollo. Los valores reales viven en Vercel (marcados como sensibles).

# ── Clerk (aplicación "Orkesta Diagnóstico", app_3JUqcVntdda5YxeTUZNFhxQocEo) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# ── Supabase ORKESTA_OPS_2026 (solo servidor) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── JARVIS: Bearer para export y PUT del mapa. Mínimo 32 caracteres. ──
# También como variable de entorno de usuario en el PC de Aitor. Nunca en el workspace.
DIAGNOSTICO_ADMIN_TOKEN=

# ── n8n (motor "Orkesta - Motor de Diagnóstico - v1", n8n personal de Aitor). ──
# Si faltan, la app funciona igual y no envía eventos. El mismo secreto va en los nodos
# Code del workflow (ver n8n/README.md).
N8N_WEBHOOK_URL=https://acgrowthmarketing.app.n8n.cloud/webhook/diagnostico-motor
DIAGNOSTICO_HMAC_SECRET=

# ── URL pública de los enlaces al cliente (cuando exista diagnostico.orkestaia.com). ──
# Sin ella, los enlaces usan el host desde el que se abre el panel.
DIAGNOSTICO_URL_PUBLICA=

# ── Enlace a la política de privacidad en la bienvenida del previo (opcional). ──
NEXT_PUBLIC_POLITICA_PRIVACIDAD_URL=
