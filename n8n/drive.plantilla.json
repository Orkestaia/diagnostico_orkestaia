        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('Pedir archivos a la app').first().json.carpeta_raiz, mimeType: 'application/vnd.google-apps.folder' }) }}",
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "vZ6HJRfkvw7OQLiF",
          "name": "Google Drive Orkesta "
        }
      }
    },
    {
      "id": "drive-8",
      "name": "Un elemento por cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Llega de «¿Falta la raíz?» (ya existía: raizId) o de «Crear carpeta raíz» (recién creada: id).\nconst e = $input.first().json;\nconst raizId = e.raizId || e.id;\nconst { clientes } = $('Pedir archivos a la app').first().json;\nreturn clientes.map(c => ({ json: { raizId, carpeta: c.carpeta, archivos: c.archivos } }));"
      }
    },
    {
      "id": "drive-9",
      "name": "Buscar carpeta del cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ \"name = '\" + $json.carpeta.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"' and '\" + $json.raizId + \"' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false\" }}"
            },
            {
              "name": "fields",
              "value": "files(id,name,appProperties)"
            },
            {
              "name": "spaces",
              "value": "drive"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "vZ6HJRfkvw7OQLiF",
          "name": "Google Drive Orkesta "
        }
      }
    },
    {
      "id": "drive-10",
      "name": "¿Hay carpeta?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((it, i) => {\n  const base = $('Un elemento por cliente').itemMatching(i).json;\n  const f = (it.json.files || [])[0];\n  return { json: { ...base, carpetaId: f ? f.id : null } };\n});"
      }
    },
    {
      "id": "drive-11",
      "name": "¿Falta la carpeta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c-¿Falta la carpeta?",
              "leftValue": "={{ !$json.carpetaId }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "drive-12",
      "name": "Crear carpeta del cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.carpeta, mimeType: 'application/vnd.google-apps.folder', parents: [$json.raizId] }) }}",
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "vZ6HJRfkvw7OQLiF",
          "name": "Google Drive Orkesta "
        }
      }
    },
    {
      "id": "drive-13",
      "name": "Un elemento por archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Llega de «¿Falta la carpeta?» (ya existía) o de «Crear carpeta del cliente» (recién creada).\nconst salida = [];\n$input.all().forEach((it, i) => {\n  const base = it.json.archivos ? it.json : $('¿Hay carpeta?').itemMatching(i).json;\n  const carpetaId = base.carpetaId || it.json.id;\n  for (const a of base.archivos) salida.push({ json: { carpetaId, carpeta: base.carpeta, nombre: a.nombre, contenido: a.contenido, hash: a.hash } });\n});\nreturn salida;"
      }
    },
    {
      "id": "drive-14",
      "name": "Buscar archivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ \"name = '\" + $json.nombre.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"' and '\" + $json.carpetaId + \"' in parents and trashed = false\" }}"
            },
            {
              "name": "fields",
              "value": "files(id,name,appProperties)"
            },
            {
              "name": "spaces",
              "value": "drive"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
