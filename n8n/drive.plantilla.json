    },
    {
      "id": "drive-15",
      "name": "Decidir qué subir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Solo se sube lo que ha cambiado: la huella viaja en appProperties.hash del archivo en Drive.\nconst LIM = 'orkesta_limite';\nconst salida = [];\n$input.all().forEach((it, i) => {\n  const a = $('Un elemento por archivo').itemMatching(i).json;\n  const f = (it.json.files || [])[0];\n  if (f && f.appProperties && f.appProperties.hash === a.hash) return;\n  const meta = { name: a.nombre, mimeType: 'text/markdown', appProperties: { hash: a.hash } };\n  if (!f) meta.parents = [a.carpetaId];\n  const cuerpo = '--' + LIM + '\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n' + JSON.stringify(meta)\n    + '\\r\\n--' + LIM + '\\r\\nContent-Type: text/markdown; charset=UTF-8\\r\\n\\r\\n' + a.contenido + '\\r\\n--' + LIM + '--';\n  salida.push({ json: { nuevo: !f, id: f ? f.id : null, carpeta: a.carpeta, nombre: a.nombre, cuerpo } });\n});\nreturn salida;"
      }
    },
